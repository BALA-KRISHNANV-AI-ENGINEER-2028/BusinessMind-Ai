# =============================================================================
# BusinessMind AI — Server Environment Configuration
# =============================================================================

# Server Environment
NODE_ENV=production
PORT=3000
HOST=0.0.0.0
LOG_LEVEL=info

# API & Security
API_VERSION=v1
FRONTEND_URL=http://localhost:3000
CORS_ORIGINS=http://localhost:3000

# Authentication & JWT
JWT_SECRET=your-jwt-secret-key-min-32-chars-change-in-production
JWT_EXPIRES_IN=15m
JWT_REFRESH_SECRET=your-jwt-refresh-secret-min-32-chars-change-in-production
JWT_REFRESH_EXPIRES_IN=7d
DEVELOPER_PASSWORD=your-secure-developer-password

# Google OAuth (Optional)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_CALLBACK_URL=http://localhost:3000/api/v1/auth/google/callback

# Database (MongoDB Atlas)
MONGODB_URI=mongodb+srv://<username>:<password>@<cluster>.mongodb.net/?retryWrites=true&w=majority
MONGODB_DB_NAME=businessmind-ai
MONGODB_MAX_POOL_SIZE=10

# AI Embeddings & Vector Search (Gemini / OpenAI / Mock)
# Supported: gemini, openai, mock
EMBEDDING_PROVIDER=gemini
EMBEDDING_MODEL=text-embedding-004
# Note: Google Gemini uses 768 dimensions; OpenAI uses 1536 dimensions.
# The Atlas Vector Search index 'document_chunk_vector_index' numDimensions MUST match.
EMBEDDING_DIMENSIONS=768
EMBEDDING_API_KEY=your-gemini-api-key

# AI LLM Generation (Gemini / OpenAI / Mock)
# Supported: gemini, openai, mock
LLM_PROVIDER=gemini
LLM_MODEL=gemini-2.5-flash
LLM_API_KEY=your-gemini-api-key
LLM_TEMPERATURE=0.1
LLM_MAX_OUTPUT_TOKENS=1024
LLM_TIMEOUT_MS=30000
LLM_MAX_RETRIES=2

# Shared Gemini API Key fallback (used if EMBEDDING_API_KEY or LLM_API_KEY is not set)
GEMINI_API_KEY=your-gemini-api-key

# RAG & Chunking Configuration
CHUNK_SIZE=500
CHUNK_OVERLAP=50
MAX_CHUNK_LENGTH=1500
RETRIEVAL_TOP_K=5
RETRIEVAL_MIN_SCORE=0.65
MAX_CONTEXT_CHUNKS=5
MAX_CONTEXT_CHARS=12000
MIN_EVIDENCE_SCORE=0.65
VECTOR_INDEX_NAME=document_chunk_vector_index

# Rate Limiting
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100

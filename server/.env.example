# BusinessMind AI — Backend Environment Variables
# ─────────────────────────────────────────────────────────────────────────────
# Copy this file to .env and fill in the values.
# .env is gitignored — NEVER commit real credentials.
# ─────────────────────────────────────────────────────────────────────────────

# ─── Server ──────────────────────────────────────────────────────────────────
NODE_ENV=production
PORT=8000
HOST=0.0.0.0

# ─── Frontend & CORS ─────────────────────────────────────────────────────────
# Deployed frontend URL — used for OAuth callback redirects
FRONTEND_URL=https://your-frontend-app.onrender.com
# Comma-separated list of allowed CORS origins
CORS_ORIGINS=https://your-frontend-app.onrender.com

# ─── MongoDB Atlas ────────────────────────────────────────────────────────────
# Format: mongodb+srv://<username>:<password>@<cluster>.mongodb.net/<dbname>
MONGODB_URI=mongodb+srv://username:password@cluster.mongodb.net/businessmind-ai
MONGODB_DB_NAME=businessmind-ai
MONGODB_MAX_POOL_SIZE=10

# ─── JWT Secrets ─────────────────────────────────────────────────────────────
# Generate with: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_SECRET=CHANGE_ME_generate_a_strong_secret_at_least_64_chars
JWT_EXPIRES_IN=15m
JWT_REFRESH_SECRET=CHANGE_ME_generate_a_different_strong_secret
JWT_REFRESH_EXPIRES_IN=7d

# ─── Developer Account Seeding ────────────────────────────────────────────────
# Required ONLY when running `npm run seed:developer`
# Must be at least 12 chars with uppercase, lowercase, number, and special char.
DEVELOPER_PASSWORD=your-strong-private-password

# ─── Google OAuth 2.0 Credentials ─────────────────────────────────────────────
# Obtained from Google Cloud Console -> APIs & Services -> Credentials -> OAuth 2.0 Client IDs
GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-google-client-secret
# Must match Authorized Redirect URI in Google Cloud Console exactly
GOOGLE_CALLBACK_URL=https://your-backend-service.onrender.com/api/v1/auth/google/callback

# ─── Rate Limiting ────────────────────────────────────────────────────────────
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100

# ─── Logging & API ────────────────────────────────────────────────────────────
LOG_LEVEL=info
API_VERSION=v1

# ─── Phase 7 — RAG Foundation (Document Chunking, Embeddings, Retrieval) ─────
# Provider: 'openai' (production) or 'mock' (development / offline testing)
EMBEDDING_PROVIDER=mock
# Embedding model (OpenAI default: text-embedding-3-small)
EMBEDDING_MODEL=text-embedding-3-small
# Embedding dimensions (MUST match Atlas Vector Search index definition)
EMBEDDING_DIMENSIONS=1536
# OpenAI API Key (Required ONLY if EMBEDDING_PROVIDER=openai)
EMBEDDING_API_KEY=sk-proj-your-openai-api-key-here

# Target chunk size in characters (~250 tokens)
CHUNK_SIZE=1000
# Character overlap between adjacent chunks (~20%)
CHUNK_OVERLAP=200

# Retrieval defaults
RETRIEVAL_TOP_K=5
RETRIEVAL_MIN_SCORE=0.70
# Name of the Atlas Vector Search index on the documentchunks collection
VECTOR_INDEX_NAME=document_chunk_vector_index

# ─── Phase 8 — LLM Integration ────────────────────────────────────────────────
# Provider: 'openai' (production) or 'mock' (development / offline testing)
LLM_PROVIDER=mock
# LLM model name (OpenAI default: gpt-4o-mini)
LLM_MODEL=gpt-4o-mini
# LLM API key — server-side only, NEVER expose this to the browser or frontend code
# For OpenAI, this can be the same key as EMBEDDING_API_KEY or a separate one
LLM_API_KEY=sk-proj-your-openai-api-key-here
# Generation temperature (0.0 = deterministic, 1.0 = creative)
# Keep low for business intelligence — 0.1 recommended
LLM_TEMPERATURE=0.1
# Maximum tokens allowed in a single LLM response (cost control)
LLM_MAX_OUTPUT_TOKENS=1024
# LLM request timeout in milliseconds (default: 30 seconds)
LLM_TIMEOUT_MS=30000
# Maximum retry attempts for transient LLM failures (rate limits, server errors)
LLM_MAX_RETRIES=2

# ─── Phase 8 — Context Limits ─────────────────────────────────────────────────
# Maximum number of evidence chunks to include in LLM context
MAX_CONTEXT_CHUNKS=5
# Maximum total character budget for evidence context (~4 chars per token, so 12000 ≈ 3000 tokens)
MAX_CONTEXT_CHARS=12000
# Maximum character length of any single chunk passed to the LLM
MAX_CHUNK_LENGTH=1000
# Minimum cosine similarity score for evidence to be considered sufficient
# Applied as an additional gate after RETRIEVAL_MIN_SCORE
MIN_EVIDENCE_SCORE=0.65


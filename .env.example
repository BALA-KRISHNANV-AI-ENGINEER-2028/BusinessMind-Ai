# BusinessMind AI — Frontend Environment Variables
# ─────────────────────────────────────────────────────────────────────────────
# Copy this file to .env or set these in your Render Static Site environment variables.
# .env is gitignored — NEVER commit real secrets.
# All VITE_* variables are exposed to the browser bundle at build time.
# ─────────────────────────────────────────────────────────────────────────────

# ─── API Configuration ────────────────────────────────────────────────────────
# Production URL of your deployed backend Express API
VITE_API_BASE_URL=https://your-backend-service.onrender.com/api/v1

# BusinessMind AI — Environment Variables
# ─────────────────────────────────────────────────────────────────────────────
# Copy this file to .env.local and fill in the values.
# .env.local is gitignored — NEVER commit real credentials to the repository.
# All VITE_* variables are exposed to the browser bundle at build time.
# ─────────────────────────────────────────────────────────────────────────────

# ─── Phase 2 (Frontend Foundation) ──────────────────────────────────────────
# No environment variables required yet.

# ─── Phase 3 (Authentication & User Management) ──────────────────────────────
# VITE_GOOGLE_CLIENT_ID=

# ─── Phase 4 (Backend API Integration) ────────────────────────────────────────
# VITE_API_BASE_URL=http://localhost:8000/api/v1
# VITE_MONGODB_APP_ID=

# ─── Phase 5 (AI Integration) ─────────────────────────────────────────────────
# VITE_AI_SERVICE_URL=
# VITE_OPENAI_API_KEY=         ← server-side only, never expose in Vite
